APP_NAME=Helpdesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
INERTIA_SSR_ENABLED=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Use redis in multi-instance production: MCP drafts, OTP challenges,
# pending registrations, rate limits, and locks must be shared.
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=
WA_CONNECT_TIMEOUT=5
WA_API_TIMEOUT=8

# Optional override; otherwise the release-bundled talenta-list-employee.json is used.
# Use the same readable file on every production application node.
# TALENTA_EMPLOYEE_FILE=/srv/helpdesk/shared/talenta-list-employee.json

PHONE_OTP_LOGIN_TTL_MINUTES=5
WHATSAPP_OTP_TTL_MINUTES=5

# Setelah migration, kelola token dan nilai MCP server-wide melalui
# Admin > Pengaturan > Pengaturan MCP. Environment lama tetap didukung sebagai
# rollout fallback; lihat docs/mcp/README.md untuk daftar lengkapnya.
# Nilai ini tetap client-local: gunakan ID berbeda pada setiap klien AI stdio.
HELPDESK_MCP_LOCAL_CLIENT_ID=
