APP_NAME=Helpdesk
APP_DESCRIPTION=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=null
# Use redis in multi-instance production: MCP drafts, OTP challenges,
# pending registrations, rate limits, and locks must be shared.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MINIO_KEY=
MINIO_SECRET=
MINIO_ENDPOINT=
MINIO_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=

WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=

# Optional override; otherwise the release-bundled talenta-list-employee.json is used.
# Use the same readable file on every production application node.
# TALENTA_EMPLOYEE_FILE=/srv/helpdesk/shared/talenta-list-employee.json

PHONE_OTP_LOGIN_TTL_MINUTES=5
WHATSAPP_OTP_TTL_MINUTES=5

HELPDESK_MCP_TOKEN=
# Optional comma-separated tokens. Every token is a distinct MCP client identity.
# Keep an old token until its active intakes finish; bindings/state do not migrate to a new token.
HELPDESK_MCP_TOKENS=
HELPDESK_MCP_INTAKE_TTL_MINUTES=30
HELPDESK_MCP_RATE_LIMIT_PER_MINUTE=300
# Optional dedicated HMAC pepper. APP_KEY is used when empty.
HELPDESK_MCP_IDENTITY_PEPPER=
# Optional shared secret for trusted WhatsApp gateway identity assertions.
HELPDESK_MCP_IDENTITY_ASSERTION_SECRET=
HELPDESK_MCP_IDENTITY_ASSERTION_LEEWAY_SECONDS=300
# Set a different stable value for each local stdio AI client to persist bindings safely.
HELPDESK_MCP_LOCAL_CLIENT_ID=
