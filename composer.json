{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "awcodes/overlook": "^3.0",
        "bezhansalleh/filament-exceptions": "^4.2",
        "bezhansalleh/filament-language-switch": "^5.0",
        "bezhansalleh/filament-shield": "^4.2",
        "dutchcodingcompany/filament-socialite": "^3.2",
        "filament/filament": "^4.11",
        "filament/infolists": "^4.11",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^3.3",
        "jeffgreco13/filament-breezy": "^3.2",
        "kungfufafa/mekaya-theme": "@dev",
        "laravel/framework": "^12.61",
        "laravel/mcp": "^0.9.4",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.28",
        "leandrocfe/filament-apex-charts": "^5.1",
        "owenvoke/blade-fontawesome": "^2.9",
        "pusher/pusher-php-server": "^7.2",
        "pxlrbt/filament-excel": "^3.6",
        "stechstudio/filament-impersonate": "^5.6"
    },
    "require-dev": {
        "andyabih/laravel-to-uml": "^1.0",
        "barryvdh/laravel-debugbar": "^4.3",
        "doctrine/dbal": "^4.2",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.17",
        "kitloong/laravel-migrations-generator": "^7.4",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.8.2",
        "phpunit/phpunit": "^11.5",
        "reliese/laravel": "^1.2",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kungfufafa/mekaya-theme.git",
            "no-api": true
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "apriansyahrs/mekaya-theme": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
